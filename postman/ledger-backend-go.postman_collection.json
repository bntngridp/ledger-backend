      "item": [
        {
          "name": "Register Budi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"budi\",\n  \"email\": \"budi@mail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('budi_user_id', json.data.user_id);",
                  "  pm.environment.set('budi_wallet_id', json.data.wallet_id);",
                  "  console.log('Budi User ID:', json.data.user_id);",
                  "  console.log('Budi Wallet ID:', json.data.wallet_id);",
                  "}"
                ]
              }
            }
